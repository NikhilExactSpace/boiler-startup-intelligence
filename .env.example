# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# mock | replay | live. Mock replays generated startups at an accelerated rate.
KAIROS_MODE=mock

# Reuse the existing Multi-Agent RCA historian settings.
DC_QUERY_URL=
KAIROS_USERNAME=
KAIROS_PASSWORD=
KAIROS_TIMEOUT_S=30
KAIROS_BATCH_SIZE=8

# ---------------------------------------------------------------------------
# Insight layer (optional; deterministic fallback is always available)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyDkhld6cx3mNtUY0ninvsG6-z2na_VWTDI
GEMINI_MODEL=gemini-2.5-flash
INSIGHT_PROVIDER=gemini

# PDF / scanned-image transcription. `auto`-style behaviour is built in: PDFs and images
# use Gemini when a key is present, and text uploads stay on the deterministic parser.
# Set to `deterministic` to force the local parser (images then return a clear 422).
EXTRACTION_PROVIDER=gemini
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Demo / runtime
# ---------------------------------------------------------------------------
DEMO_BOILER_ID=B-101
DATABASE_PATH=backend/data/bsi.db
RAG_DATABASE_URL=postgresql://localhost:5432/boileriq
LIVE_TIME_SCALE=120
LIVE_POLL_SECONDS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
